# ── 9. Go ────────────────────────────────────────────────────────────────
check_go() {
  local current latest
  current=$(cmd_exists go && go version | awk '{print $3}' | sed 's/^go//' || echo "not-installed")
  latest=$(curl -fsL "https://go.dev/dl/?mode=json" 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['version'][2:])" 2>/dev/null \
    || echo "unknown")
  [ "$current" = "$latest" ] && { ok "go      ${current}"; return 0; } \
                            || { warn "go      ${current} → ${latest}"; return 1; }
}

update_go() {
  local ver
  ver=$(curl -fsL "https://go.dev/dl/?mode=json" 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0]['version'][2:])" 2>/dev/null)
  [ -z "$ver" ] && { fail "Could not determine latest Go version"; return 1; }

  log "Downloading Go ${ver}..."
  local archive="go${ver}.darwin-arm64.tar.gz"
  curl -fsL "https://go.dev/dl/${archive}" -o "/tmp/${archive}" || { fail "Go download failed"; return 1; }
  tar xzf "/tmp/${archive}" -C "$OPT_DIR"
  mv "$OPT_DIR/go" "$OPT_DIR/go${ver}"
  # update symlinks
  ln -sfn "$OPT_DIR/go${ver}/bin/go" "$TOOLS_DIR/go"
  ln -sfn "$OPT_DIR/go${ver}/bin/gofmt" "$TOOLS_DIR/gofmt"
  rm -f "/tmp/${archive}"
  # clean old dirs (keep last 2)
  local dirs
  dirs=$(ls -d "$OPT_DIR"/go[0-9]* 2>/dev/null | sort -V)
  local count
  count=$(echo "$dirs" | wc -l | tr -d ' ')
  [ "$count" -gt 2 ] && echo "$dirs" | head -n $((count - 2)) | xargs -I{} rm -rf {}
  ok "go      updated to ${ver}"
}

# ── 10. Homebrew (casks only) ────────────────────────────────────────────
check_homebrew() {
  if ! cmd_exists brew; then
    warn "Homebrew not installed"
    return 1
  fi
  local outdated
  outdated=$(brew outdated --cask --quiet 2>/dev/null | wc -l | tr -d ' ')
  local cask_count
  cask_count=$(brew list --cask -1 2>/dev/null | wc -l | tr -d ' ')

  if [ -z "$outdated" ] || [ "$outdated" -eq 0 ]; then
    ok "brew    ${cask_count} casks, all up-to-date"
    return 0
  else
    warn "brew    ${outdated}/${cask_count} casks outdated"
    brew outdated --cask 2>/dev/null | while IFS= read -r line; do
      warn "         ${line}"
    done
    return 1
  fi
}

update_homebrew() {
  brew update 2>/dev/null
  brew upgrade --cask 2>/dev/null
  ok "brew    updated all casks"
}

# ── 11. Global npm packages ──────────────────────────────────────────────
TOOL_NPM_BIN="$OPT_DIR/node-v22.14.0-darwin-arm64/bin/npm"
check_npm_global() {
  if ! cmd_exists npm; then
    warn "npm not available"
    return 1
  fi
  local outdated
  outdated=$(npm outdated -g --parseable 2>/dev/null | wc -l | tr -d ' ')
  local count
  count=$(npm ls -g --depth=0 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
  if [ "$outdated" -eq 0 ]; then
    ok "npm-g   ${count} pkgs, all up-to-date"
    return 0
  else
    warn "npm-g   ${outdated}/${count} pkgs outdated"
    npm outdated -g 2>/dev/null | tail -n +2 | while IFS= read -r line; do
      warn "         $(echo "$line" | awk '{print $1, $2, "→", $4}')"
    done
    return 1
  fi
}

update_npm_global() {
  npm update -g 2>/dev/null
  ok "npm-g   updated all packages"
}

# ── 12. Pip packages ─────────────────────────────────────────────────────
# system packages shipped with macOS that we skip
PIP_SYSTEM_PKGS="pip setuptools wheel six altgraph future macholib"

check_pip() {
  if ! cmd_exists pip3; then
    warn "pip3 not available"
    return 1
  fi
  local total_count user_outdated
  total_count=$(pip3 list --format=columns 2>/dev/null | tail -n +3 | wc -l | tr -d ' ')
  user_outdated=$(pip3 list --outdated --format=columns 2>/dev/null | tail -n +3 | awk '{print $1}' \
    | while IFS= read -r pkg; do
        echo "$PIP_SYSTEM_PKGS" | grep -qw "$pkg" 2>/dev/null || echo "$pkg"
      done | wc -l | tr -d ' ')

  if [ "$user_outdated" -eq 0 ]; then
    ok "pip3    ${total_count} pkgs, all up-to-date"
    return 0
  else
    warn "pip3    ${user_outdated}/${total_count} pkgs outdated (user)"
    pip3 list --outdated --format=columns 2>/dev/null | tail -n +3 | while IFS= read -r line; do
      local pkg old_ver new_ver
      pkg=$(echo "$line" | awk '{print $1}')
      old_ver=$(echo "$line" | awk '{print $2}')
      new_ver=$(echo "$line" | awk '{print $3}')
      if echo "$PIP_SYSTEM_PKGS" | grep -qw "$pkg"; then
        warn "         ${pkg} ${old_ver} → ${new_ver} ${YELLOW}(system — skip)${NC}"
      else
        warn "         ${pkg} ${old_ver} → ${new_ver}"
      fi
    done
    return 1
  fi
}

update_pip() {
  pip3 list --outdated --format=columns 2>/dev/null | tail -n +3 | while IFS= read -r line; do
    local pkg old_ver
    pkg=$(echo "$line" | awk '{print $1}')
    echo "$PIP_SYSTEM_PKGS" | grep -qw "$pkg" && continue
    old_ver=$(echo "$line" | awk '{print $2}')
    log "Upgrading pip: ${pkg} ${old_ver} ..."
    pip3 install --upgrade --quiet "$pkg" 2>/dev/null
  done
  ok "pip3    updated user packages"
}

