# ── 16. Zsh plugins (autosuggestions + syntax-highlighting) ──────────────
ZSH_PLUGIN_DIR="$HOME/.local/share/zsh/plugins"
ZSH_PLUGINS=(
  "zsh-autosuggestions:zsh-users/zsh-autosuggestions"
  "zsh-syntax-highlighting:zsh-users/zsh-syntax-highlighting"
)

check_zsh_plugins() {
  local outdated=0
  local total=${#ZSH_PLUGINS[@]}
  local entry name dir commit_date
  for entry in "${ZSH_PLUGINS[@]}"; do
    name="${entry%%:*}"
    dir="$ZSH_PLUGIN_DIR/$name"
    if [ ! -d "$dir" ]; then
      warn "zsh-plug ${name}  not-installed"
      outdated=$((outdated + 1))
    else
      commit_date=$(cd "$dir" && git log -1 --format=%cs 2>/dev/null || echo "?")
      ok "zsh-plug ${name}  ${commit_date}"
    fi
  done
  return "$outdated"
}

update_zsh_plugins() {
  for entry in "${ZSH_PLUGINS[@]}"; do
    local name="${entry%%:*}"
    local repo="${entry##*:}"
    local dir="$ZSH_PLUGIN_DIR/$name"
    if [ -d "$dir" ]; then
      log "Updating ${name}..."
      (cd "$dir" && git pull --ff-only --depth 1 2>/dev/null)
    fi
  done
  ok "zsh-plug updated all plugins"
}

# ── Run checks / updates ────────────────────────────────────────────────
TOOLS=(
  nvim
  node
  fzf
  rg
  starship
  zoxide
  opencode
  gh
  go
  homebrew
  npm_global
  pip
  bat
  lsd
  lazygit
  zsh_plugins
)

check_all() {
  local overall=0
  header "Tool Versions & Update Status"
  for tool in "${TOOLS[@]}"; do
    "check_${tool}" || overall=$((overall + 1))
  done
  $QUIET || printf "\n"
  if [ "$overall" -eq 0 ]; then
    ok "All tools up-to-date."
  else
    # in quiet mode, still show a summary line if something needs updating
    if $QUIET; then
      printf "▲ ${overall} tool(s) have updates available. Run: update-tools --update\n"
    else
      warn "${overall} tool(s) have updates available. Run with --update to apply."
    fi
  fi
  return "$overall"
}

update_all() {
  local updated=0
  for tool in "${TOOLS[@]}"; do
    if ! "check_${tool}" >/dev/null 2>&1; then
      header "Updating ${tool}..."
      "update_${tool}" && updated=$((updated + 1))
    fi
  done
  printf "\n"
  ok "${updated} tool(s) updated."
}

update_single() {
  local target="$1"
  # normalize: if they pass "npm" or "pip", map to internal name
  case "$target" in
    npm)          target="npm_global" ;;
    pip|pip3)     target="pip" ;;
    brew|homebrew) target="homebrew" ;;
  esac

  if ! type "check_${target}" &>/dev/null; then
    fail "Unknown tool: $target"
    echo "Available: nvim node fzf rg starship zoxide opencode gh go brew pip npm bat lsd lazygit zsh-plugins"
    return 1
  fi
  header "Checking ${target}..."
  if "check_${target}"; then
    ok "${target} is already up-to-date."
  else
    header "Updating ${target}..."
    "update_${target}"
  fi
}

# ── Main ─────────────────────────────────────────────────────────────────
if $SINGLE_MODE; then
  update_single "$UPDATE_TARGET"
elif $DO_UPDATE; then
  update_all
else
  check_all
fi
