  current=$(cmd_exists starship && starship --version | head -1 | awk '{print $2}' || echo "not-installed")
  latest=$(latest_gh_release "$TOOL_STARSHIP_REPO" | sed 's/^v//')
  # starship version output includes leading 'v' sometimes; strip it
