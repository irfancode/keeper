  rm -rf "/tmp/ripgrep-${ver}-aarch64-apple-darwin"
  ok "rg      updated to ${ver}"
}

# ── 5. starship ──────────────────────────────────────────────────────────
TOOL_STARSHIP_REPO="starship/starship"
