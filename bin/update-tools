#!/usr/bin/env zsh
# update-tools — Check and update all locally-installed tools
#   update-tools           check for available updates
#   update-tools --check   same as above
#   update-tools --update  apply all available updates
#   update-tools --update <tool>  update only named tool
#   update-tools --quiet   non-interactive, minimal output

set -euo pipefail

# ── Config ──────────────────────────────────────────────────────────────
TOOLS_DIR="$HOME/.local/bin"
OPT_DIR="$HOME/.local/opt"
FZF_DIR="$HOME/.fzf"
OPCODE_DIR="$HOME/.opencode"

# ── Colors ──────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

ok="●"     # or  "✓"
warn="▲"   # or  "!"
err="✗"    # or  "×"
info="→"

# ── Helpers ─────────────────────────────────────────────────────────────
log()  { $QUIET || printf "${NC}%b %b${NC}\n" "${info}" "$*"; }
ok()   { $QUIET || printf "${GREEN}%b %b${NC}\n" "${ok}" "$*"; }
info() { $QUIET || printf "${BLUE}%b %b${NC}\n" "${info}" "$*"; }
warn() { $QUIET || printf "${YELLOW}%b %b${NC}\n" "${warn}" "$*"; }
fail() { printf "${RED}%b %b${NC}\n" "${err}" "$*"; }  # always show failures
header() { $QUIET || printf "\n${BOLD}── %s ──${NC}\n" "$1"; }

cmd_exists() { command -v "$1" &>/dev/null; }

# scrape the latest non-prerelease tag for a GitHub repo via `gh`
latest_gh_release() {
  gh release view -R "$1" --json tagName --jq .tagName 2>/dev/null
}

version_gt() {
  # returns 0 if $1 > $2 (semver-ish comparison)
  [ "$(printf '%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ] && [ "$1" != "$2" ]
}

DO_UPDATE=false
UPDATE_TARGET=""
QUIET=false

for arg in "$@"; do
  case "$arg" in
    --update)     DO_UPDATE=true ;;
    --check)      DO_UPDATE=false ;;
    --quiet|-q)   QUIET=true ;;
    --help|-h)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    --*)
      echo "Unknown: $arg" >&2
      exit 1
      ;;
    *)
      UPDATE_TARGET="$arg"
      ;;
  esac
done

# --update with a tool name means only that tool
SINGLE_MODE=false
if $DO_UPDATE && [ -n "$UPDATE_TARGET" ]; then
  SINGLE_MODE=true
fi

# ── Tool definitions ────────────────────────────────────────────────────
# Each tool is a function following this interface:
#   check_<name>   — prints status line; returns 0 if current, 1 if behind
#   update_<name>  — performs the upgrade (called only when behind)

# ── 1. Neovim ────────────────────────────────────────────────────────────
TOOL_NVIM_REPO="neovim/neovim"
check_nvim() {
  local current latest
  current=$(cmd_exists nvim && nvim --version | head -1 | awk '{print $2}' | sed 's/^v//' || echo "not-installed")
  latest=$(latest_gh_release "$TOOL_NVIM_REPO" | sed 's/^v//')
  [ "$current" = "$latest" ] && { ok "neovim  ${current}"; return 0; } \
                            || { warn "neovim  ${current} → ${latest}"; return 1; }
}

update_nvim() {
  local ver
  ver=$(latest_gh_release "$TOOL_NVIM_REPO" | sed 's/^v//')
  log "Downloading Neovim v${ver}..."
  mkdir -p "$OPT_DIR"
  local tarball="nvim-macos-arm64.tar.gz"
  gh release download "v${ver}" -R "$TOOL_NVIM_REPO" -p "$tarball" --clobber
  tar xzf "$tarball" -C "$OPT_DIR"
  rm -f "$tarball"
  # fix up the symlink
  ln -sfn "$OPT_DIR/nvim-macos-arm64/bin/nvim" "$TOOLS_DIR/nvim"
  ok "neovim  updated to v${ver}"
}

# ── 2. Node.js ───────────────────────────────────────────────────────────
TOOL_NODE_REPO="nodejs/node"
check_node() {
  local current major latest_line latest_ver target_ver
  current=$(cmd_exists node && node --version | sed 's/^v//' || echo "not-installed")
  major=$(echo "$current" | cut -d. -f1)
  # fetch all releases and find the latest on our major line
  latest_line=$(gh release list -R "$TOOL_NODE_REPO" -L 50 2>/dev/null \
    | perl -F'\t' -lane 'print $F[-2] if $F[-2] =~ /^v/ and $F[-2] !~ /rc|nightly|alpha|beta/' \
    | grep "^v${major}\." \
    | head -1 \
    | sed 's/^v//')
  [ -z "$latest_line" ] && { latest_line="?"; latest_ver="?"; }
  latest_ver="$latest_line"

  [ "$current" = "$latest_ver" ] && { ok "node    ${current}"; return 0; } \
                                || { warn "node    ${current} → ${latest_ver} (v${major}.x)"; return 1; }
}

update_node() {
  local major latest_ver
  major=$(node --version | sed 's/^v//' | cut -d. -f1)
  latest_ver=$(gh release list -R "$TOOL_NODE_REPO" -L 50 2>/dev/null \
    | perl -F'\t' -lane 'print $F[-2] if $F[-2] =~ /^v/ and $F[-2] !~ /rc|nightly|alpha|beta/' \
    | grep "^v${major}\." \
    | head -1 \
    | sed 's/^v//')
  [ -z "$latest_ver" ] && { fail "Could not find latest Node v${major}.x"; return 1; }

  log "Downloading Node.js v${latest_ver}..."
  local dirname="node-v${latest_ver}-darwin-arm64"
  local tarball="${dirname}.tar.gz"
  local url="https://nodejs.org/dist/v${latest_ver}/${tarball}"
  curl -fsL "$url" -o "/tmp/$tarball" || { fail "Node.js download failed"; return 1; }
  tar xzf "/tmp/$tarball" -C "$OPT_DIR" || { fail "Node.js extraction failed"; return 1; }
  rm -f "/tmp/$tarball"
  # update symlinks
  ln -sfn "$OPT_DIR/$dirname/bin/node" "$TOOLS_DIR/node"
  ln -sfn "$OPT_DIR/$dirname/bin/npm"  "$TOOLS_DIR/npm"
  ln -sfn "$OPT_DIR/$dirname/bin/npx"  "$TOOLS_DIR/npx"
  # clean old dirs (keep last 2)
  local dirs
  dirs=$(ls -d "$OPT_DIR"/node-v*-darwin-arm64 2>/dev/null | sort -V)
  local count
  count=$(echo "$dirs" | wc -l | tr -d ' ')
  [ "$count" -gt 2 ] && echo "$dirs" | head -n $((count - 2)) | xargs -I{} rm -rf {}
  ok "node    updated to v${latest_ver}"
}

# ── 3. fzf (git clone) ──────────────────────────────────────────────────
TOOL_FZF_REPO="junegunn/fzf"
check_fzf() {
  local current latest
  current=$(cmd_exists fzf && fzf --version | awk '{print $1}' || echo "not-installed")
  latest=$(latest_gh_release "$TOOL_FZF_REPO" | sed 's/^v//')
  [ "$current" = "$latest" ] && { ok "fzf     ${current}"; return 0; } \
                            || { warn "fzf     ${current} → ${latest}"; return 1; }
}

update_fzf() {
  local tag
  tag=$(latest_gh_release "$TOOL_FZF_REPO")
  log "Updating fzf to ${tag}..."
  (cd "$FZF_DIR" \
    && git fetch --tags --force origin \
    && git checkout -f "$tag" \
    && make 2>/dev/null \
    && cp bin/fzf "$TOOLS_DIR/fzf")
  ok "fzf     updated to ${tag}"
}

