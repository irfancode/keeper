  latest=$(latest_gh_release "$TOOL_GH_REPO" | sed 's/^v//')
  [ "$current" = "$latest" ] && { ok "gh      ${current}"; return 0; } \
                            || { warn "gh      ${current} → ${latest}"; return 1; }
}

update_gh() {
